@model Employee_Management.Models.BankDetail

@{
    ViewData["Title"] = "Create Bank Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Create Bank Detail</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="BankDetails" asp-action="Index">Bank Records</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title p-0 mt-3 mb-4">Financial & Employee Information</h5>

                    <form asp-action="Create" class="row g-3 needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-octagon me-1"></i> Please fix the errors below.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <!-- Employee Selection -->
                        <div class="col-md-12 mb-3">
                            <label asp-for="EmployeeId" class="form-label fw-bold">Select Employee</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-select" required>
                                    <option value="" selected disabled>-- Choose Employee --</option>
                                </select>
                            </div>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">
                        <h5 class="card-title p-0 m-0 mb-3">Bank Details</h5>

                        <!-- Account Holder -->
                        <div class="col-md-6">
                            <label asp-for="AccountHolderName" class="form-label fw-bold">Account Holder Name</label>
                            <input asp-for="AccountHolderName" class="form-control" placeholder="Full name as per bank records" required />
                            <span asp-validation-for="AccountHolderName" class="text-danger small"></span>
                        </div>

                        <!-- Account Number -->
                        <div class="col-md-6">
                            <label asp-for="AccountNumber" class="form-label fw-bold">Account Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="AccountNumber" class="form-control" placeholder="12-16 digit account number" required />
                            </div>
                            <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                        </div>

                        <!-- Bank Name -->
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label fw-bold">Bank Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-bank"></i></span>
                                <input asp-for="BankName" class="form-control" placeholder="e.g. State Bank, HDFC" required />
                            </div>
                            <span asp-validation-for="BankName" class="text-danger small"></span>
                        </div>

                        <!-- IFSC Code -->
                        <div class="col-md-6">
                            <label asp-for="IFSCCode" class="form-label fw-bold">IFSC Code</label>
                            <input asp-for="IFSCCode" class="form-control" placeholder="IFSC code" />
                            <span asp-validation-for="IFSCCode" class="text-danger small"></span>
                        </div>

                        <!-- Branch -->
                        <div class="col-12">
                            <label asp-for="Branch" class="form-label fw-bold">Branch Name</label>
                            <input asp-for="Branch" class="form-control" placeholder="Main Branch, City" required />
                            <span asp-validation-for="Branch" class="text-danger small"></span>
                        </div>

                        <div class="col-12 text-center mt-5 mb-3">
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> Add Bank Record
                            </button>
                            <a asp-action="Index" class="btn btn-light px-5 py-2 rounded-pill ms-2 border">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}