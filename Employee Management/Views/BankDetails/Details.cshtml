@model Employee_Management.Models.BankDetail

@{
    ViewData["Title"] = "Bank Account Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Bank Account Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="BankDetails" asp-action="Index">Bank Details</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title fw-bold mb-4">Financial Institution Information</h5>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Account Holder</div>
                        <div class="col-lg-8 col-md-8 fw-bold text-dark">@Model.AccountHolderName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Bank Name</div>
                        <div class="col-lg-8 col-md-8"><i class="bi bi-bank me-2 text-primary"></i> @Model.BankName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Account Number</div>
                        <div class="col-lg-8 col-md-8 fw-bold">•••• @(Model.AccountNumber.Length > 4 ? Model.AccountNumber.Substring(Model.AccountNumber.Length - 4) : Model.AccountNumber)</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">IFSC Code</div>
                        <div class="col-lg-8 col-md-8"><span class="badge bg-light text-secondary border px-3">@Model.IFSCCode</span></div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Branch</div>
                        <div class="col-lg-8 col-md-8">@Model.Branch</div>
                    </div>

                    <hr class="my-4">

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Linked Employee</div>
                        <div class="col-lg-8 col-md-8">
                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" class="text-decoration-none fw-bold">
                                <i class="bi bi-person-circle me-1"></i> View Employee Profile
                            </a>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-5">
                        <a asp-action="Edit" asp-route-id="@Model.BankDetailId" class="btn btn-primary px-4 rounded-pill">
                            <i class="bi bi-pencil me-1"></i> Update Details
                        </a>
                        <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body pt-4 text-center">
                    <i class="bi bi-shield-lock display-4"></i>
                    <h5 class="card-title text-white mt-3">Secure Records</h5>
                    <p class="small opacity-75">Bank account information is encrypted and stored securely for payroll processing purposes only.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; }
</style>
