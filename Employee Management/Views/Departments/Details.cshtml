@model Employee_Management.Models.Department

@{
    ViewData["Title"] = "Department Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Department Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Departments" asp-action="Index">Departments</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title fw-bold mb-4">Organizational Unit Info</h5>

                    <div class="row mb-4">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Department Name</div>
                        <div class="col-lg-8 col-md-8 fw-bold text-primary fs-5">
                            <i class="bi bi-building me-2"></i> @Model.DepartmentName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4 col-md-4 label fw-bold text-muted small">Department ID</div>
                        <div class="col-lg-8 col-md-8"># @Model.DepartmentId</div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-primary px-4 rounded-pill">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 info-card sales-card">
                <div class="card-body">
                    <h5 class="card-title">Department Stats <span>| Summary</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-primary-light text-primary">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="ps-3">
                            <h6>@Model.Employees?.Count</h6>
                            <span class="text-muted small pt-2">Total Employees</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .bg-primary-light { background-color: #f0f2ff; width: 64px; height: 64px; }
</style>
