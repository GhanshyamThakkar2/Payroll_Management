@model Employee_Management.Models.Designation

@{
    ViewData["Title"] = "Create Designation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Create Designation</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Designations" asp-action="Index">Designations</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title p-0 mt-3 mb-4">Designation Details</h5>

                    <form asp-action="Create" class="row g-3 needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-octagon me-1"></i> Please fix the errors below.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <div class="col-12">
                            <label asp-for="DepartmentId" class="form-label fw-bold">Assign Department</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId" required>
                                    <option value="" selected disabled>-- Select Department --</option>
                                </select>
                            </div>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold">Designation Title</label>
                            <div class="input-group has-validation">
                                <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Senior Developer, HR Manager" required />
                                <div class="invalid-feedback">Please enter the designation title.</div>
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12 text-center mt-5 mb-3">
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> Create Designation
                            </button>
                            <a asp-action="Index" class="btn btn-light px-5 py-2 rounded-pill ms-2 border">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}