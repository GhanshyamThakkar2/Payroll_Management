@model IEnumerable<Employee_Management.Models.Designation>

@{
    ViewData["Title"] = "Designations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Manage Designations</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Designations</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title p-0 m-0">Designation Directory</h5>
                        <a asp-action="Create" class="btn btn-primary rounded-pill">
                            <i class="bi bi-plus-circle me-1"></i> Add Designation
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover datatable align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-3">@Html.DisplayNameFor(model => model.Title)</th>
                                    <th class="py-3">@Html.DisplayNameFor(model => model.Department)</th>
                                    <th class="py-3 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">
                                                <i class="bi bi-briefcase me-2 text-primary"></i>
                                                @Html.DisplayFor(modelItem => item.Title)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-light text-info rounded-pill px-3">
                                                @Html.DisplayFor(modelItem => item.Department.DepartmentName)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.DesignationId" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.DesignationId" class="btn btn-sm btn-outline-info" title="Details">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <a href="javascript:void(0)" onclick="confirmDelete('@Url.Action("Delete", new { id = item.DesignationId })')" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-info-light { background-color: #e0f3ff; }
    .table thead th { border: none; color: #899bbd; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
    .card { border-radius: 12px; }
</style>

