@model Employee_Management.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Employee Profile</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Employees" asp-action="Index">Employees</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section profile">
    <div class="row">
        <!-- Sidebar Profile Card -->
        <div class="col-xl-4">
            <div class="card shadow-sm border-0">
                <div class="card-body profile-card pt-4 d-flex flex-column align-items-center text-center">
                    <div class="bg-light rounded-circle p-4 mb-3" style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-person-fill text-primary" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="fw-bold text-dark">@Model.Name</h2>
                    <h3 class="text-muted small">@Model.Designation?.Title</h3>
                    <div class="mt-2">
                        @if (Model.Status)
                        {
                            <span class="badge bg-success rounded-pill px-3"><i class="bi bi-check-circle me-1"></i> Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3"><i class="bi bi-x-circle me-1"></i> Inactive</span>
                        }
                    </div>
                    
                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary btn-sm rounded-pill px-4">
                            <i class="bi bi-pencil me-1"></i> Edit Profile
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Info Tabs -->
        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <ul class="nav nav-tabs nav-tabs-bordered">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-overview">Overview</button>
                        </li>
                    </ul>

                    <div class="tab-content pt-2">
                        <div class="tab-pane fade show active profile-overview" id="profile-overview">
                            
                            <h5 class="card-title fw-bold mt-3 mb-4">Personal Details</h5>
                            
                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small uppercase">Full Name</div>
                                <div class="col-lg-9 col-md-8 text-dark fw-bold">@Model.Name</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Father's Name</div>
                                <div class="col-lg-9 col-md-8">@Model.FatherName</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Date of Birth</div>
                                <div class="col-lg-9 col-md-8">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Gender</div>
                                <div class="col-lg-9 col-md-8">@Model.Gender</div>
                            </div>

                            <h5 class="card-title fw-bold mt-5 mb-4">Contact Information</h5>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Phone</div>
                                <div class="col-lg-9 col-md-8"><a href="tel:@Model.Phone" class="text-decoration-none text-primary">@Model.Phone</a></div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Email</div>
                                <div class="col-lg-9 col-md-8"><a href="mailto:@Model.Email" class="text-decoration-none text-primary">@Model.Email</a></div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Local Address</div>
                                <div class="col-lg-9 col-md-8">@Model.LocalAddress</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Permanent Address</div>
                                <div class="col-lg-9 col-md-8">@Model.PermanentAddress</div>
                            </div>

                            <h5 class="card-title fw-bold mt-5 mb-4">Professional & Financials</h5>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Department</div>
                                <div class="col-lg-9 col-md-8"><span class="badge bg-light text-primary border px-3 py-2">@Model.Department?.DepartmentName</span></div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Designation</div>
                                <div class="col-lg-9 col-md-8">@Model.Designation?.Title</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Basic Salary</div>
                                <div class="col-lg-9 col-md-8 text-success fw-bold">@Model.BasicSalary.ToString("C2")</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Total Allowance</div>
                                <div class="col-lg-9 col-md-8">@Model.Allowance.ToString("C2")</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-3 col-md-4 label fw-bold text-muted small">Total Deduction</div>
                                <div class="col-lg-9 col-md-8 text-danger">@Model.Deduction.ToString("C2")</div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .uppercase { text-transform: uppercase; }
</style>
