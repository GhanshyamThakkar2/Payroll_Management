@model IEnumerable<Employee_Management.Models.Payslip>

@{
    ViewData["Title"] = "My Payslips";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>My Payslips</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active">My Payslips</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">My Salary Statements</h5>
                    <p class="text-muted small">View and download your generated payslips below.</p>

                    <div class="table-responsive mt-3">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Period</th>
                                    <th class="text-center">Earnings</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(item.Month) @item.Year</div>
                                            <small class="text-muted">ID: #@item.PayslipId</small>
                                        </td>
                                        <td class="text-center">
                                            <div class="text-success fw-bold">@item.NetSalary.ToString("C2")</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-success">@item.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Payslips" asp-action="DownloadPdf" asp-route-id="@item.PayslipId" 
                                               class="btn btn-sm btn-outline-primary shadow-sm" target="_blank">
                                                <i class="bi bi-download me-1"></i> Download PDF
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <i class="bi bi-file-earmark-x fs-1 text-muted"></i>
                                            <p class="mt-2 text-muted">No payslips generated for your profile yet.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
