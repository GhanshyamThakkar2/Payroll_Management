@model Employee_Management.Models.Payslip

@{
    ViewData["Title"] = "Create Payslip";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Generate Payslip</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Payslips" asp-action="Index">Payslips</a></li>
            <li class="breadcrumb-item active">Generate</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title p-0 mt-3 mb-4">Payroll Configuration</h5>

                    <form asp-action="Create" class="row g-3 needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-octagon me-1"></i> Please fix the errors below.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <!-- Employee Selection -->
                        <div class="col-md-6">
                            <label asp-for="EmployeeId" class="form-label fw-bold">Employee</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <select id="EmployeeId" asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId" required>
                                    <option value="" selected disabled>-- Select Employee --</option>
                                </select>
                            </div>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>

                        <!-- Payslip Date -->
                        <div class="col-md-6">
                            <label asp-for="PayslipDate" class="form-label fw-bold">Generation Date</label>
                            <input asp-for="PayslipDate" class="form-control" type="date" id="PayslipDate" readonly />
                        </div>

                        <!-- Period Selection -->
                        <div class="col-md-6">
                            <label asp-for="Month" class="form-label fw-bold">Month</label>
                            <select asp-for="Month" class="form-select" required>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8">August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Year" class="form-label fw-bold">Year</label>
                            <select asp-for="Year" class="form-select" required>
                                @foreach (var year in new int[] { DateTime.Now.Year - 1, DateTime.Now.Year, DateTime.Now.Year + 1 })
                                {
                                    <option value="@year" selected="@(year == DateTime.Now.Year)">@year</option>
                                }
                            </select>
                        </div>

                        <hr class="my-4">
                        <h5 class="card-title p-0 m-0 mb-3 text-primary">Earnings & Deductions (Auto-filled)</h5>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Basic Salary</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="BasicSalary" class="form-control bg-light" id="basicSalary" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Total Allowances</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-success">+</span>
                                <input asp-for="TotalAllowances" class="form-control bg-light" id="allowance" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Total Deductions</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-danger">-</span>
                                <input asp-for="TotalDeductions" class="form-control bg-light" id="deduction" readonly />
                            </div>
                        </div>

                        <div class="col-md-12 mt-4">
                            <div class="alert alert-info border-0 shadow-sm d-flex justify-content-between align-items-center mb-0">
                                <h5 class="m-0 fw-bold"><i class="bi bi-wallet2 me-2"></i> Est. Net Salary:</h5>
                                <h4 class="m-0 fw-bold" id="netSalaryDisplay">$0.00</h4>
                                <input type="hidden" asp-for="NetSalary" id="netSalary" />
                            </div>
                        </div>

                        <hr class="my-4">
                        <h5 class="card-title p-0 m-0 mb-3">Additional Info</h5>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold">Payment Status</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="Generated">Generated</option>
                                <option value="Paid">Paid</option>
                                <option value="Unpaid">Unpaid</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Comments" class="form-label fw-bold">Internal Comments</label>
                            <input asp-for="Comments" class="form-control" placeholder="Optional notes" />
                        </div>

                        <div class="col-12 text-center mt-5 mb-3">
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">
                                <i class="bi bi-file-earmark-check me-1"></i> Generate & Save
                            </button>
                            <a asp-action="Index" class="btn btn-light px-5 py-2 rounded-pill ms-2 border">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // Set current date
            var today = new Date().toISOString().split('T')[0];
            $("#PayslipDate").val(today);

            $("#EmployeeId").change(function () {
                var employeeId = $(this).val();

                if (employeeId) {
                    $.ajax({
                        url: '/Payslips/GetEmployeeSalaryDetails',
                        type: 'GET',
                        data: { employeeId: employeeId },
                        success: function (data) {
                            if (data) {
                                $("#basicSalary").val(data.basicSalary);
                                $("#allowance").val(data.totalAllowances);
                                $("#deduction").val(data.totalDeductions);
                                CalculateNetSalary();
                            }
                        }
                    });
                }
            });

            function CalculateNetSalary() {
                var basicSalary = parseFloat($("#basicSalary").val()) || 0;
                var allowances = parseFloat($("#allowance").val()) || 0;
                var deductions = parseFloat($("#deduction").val()) || 0;
                var netSalary = (basicSalary + allowances - deductions).toFixed(2);
                
                $("#netSalary").val(netSalary);
                $("#netSalaryDisplay").text("$" + netSalary);
            }
        });
    </script>
}

