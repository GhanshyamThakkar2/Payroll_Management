@model IEnumerable<Employee_Management.Models.Payslip>

@{
    ViewData["Title"] = "Payslips";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Payroll Processing</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Payslips</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title p-0 m-0">Generated Payslips</h5>
                        <a asp-action="Create" class="btn btn-primary rounded-pill">
                            <i class="bi bi-file-earmark-plus me-1"></i> Generate New
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover datatable align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-3">Employee</th>
                                    <th class="py-3 text-center">Period</th>
                                    <th class="py-3 text-center">Net Salary</th>
                                    <th class="py-3 text-center">Status</th>
                                    <th class="py-3 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@item.Employee?.Name</div>
                                            <small class="text-muted">Date: @item.PayslipDate.ToShortDateString()</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary-light text-dark">
                                                @item.Month @item.Year
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="fw-bold text-success">@item.NetSalary.ToString("C2")</div>
                                            <small class="text-muted small">Gross: @item.BasicSalary.ToString("C0")</small>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Status == "Paid" || item.Status == "Generated")
                                            {
                                                <span class="badge rounded-pill bg-success">@item.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-warning text-dark">@item.Status</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group">
                                                <a href="@Url.Content("~/payslips/Payslip" + item.EmployeeId + item.Month + item.Year + ".pdf")" 
                                                   class="btn btn-sm btn-success" target="_blank" title="Download PDF">
                                                    <i class="bi bi-file-pdf"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.PayslipId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                                <a href="javascript:void(0)" onclick="confirmDelete('@Url.Action("Delete", new { id = item.PayslipId })')" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-secondary-light { background-color: #f8f9fa; border: 1px solid #dee2e6; }
</style>