@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"] - Payrol Management</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <link href="~/template/img/favicon.png" rel="icon">
    <link href="~/template/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Nunito:wght@300;400;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="~/template/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/template/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/template/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/template/vendor/quill/quill.snow.css" rel="stylesheet">
    <link href="~/template/vendor/quill/quill.bubble.css" rel="stylesheet">
    <link href="~/template/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/template/vendor/simple-datatables/style.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <link href="~/template/css/style.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', "Open Sans", sans-serif;
            background-color: #f0f2f5;
        }

        .header {
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .sidebar {
            background: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
        }

        .sidebar-nav .nav-link {
            font-weight: 500;
            border-radius: 8px;
            margin: 2px 0;
            transition: all 0.3s ease;
        }

        .sidebar-nav .nav-link:not(.collapsed) {
            background: linear-gradient(90deg, #4154f1 0%, #717ff5 100%);
            color: #fff;
            box-shadow: 0 4px 12px rgba(65, 84, 241, 0.25);
        }

        .sidebar-nav .nav-link:not(.collapsed) i {
            color: #fff;
        }

        .sidebar-nav .nav-link.collapsed:hover {
            background-color: #f6f9ff;
            color: #4154f1;
        }

        .main {
            min-height: calc(100vh - 120px);
        }

        .footer {
            background: transparent;
            border: none;
            padding: 30px 0;
            font-size: 14px;
            color: #899bbd;
        }
        
        /* Premium Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a1a1a1;
        }
        /* Datatables Premium Styling */
        .datatable-input {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #dce1e7;
            font-size: 14px;
            transition: all 0.2s;
            box-shadow: none;
        }

        .datatable-input:focus {
            border-color: #4154f1;
            box-shadow: 0 0 0 0.25rem rgba(65, 84, 241, 0.1);
            outline: none;
        }

        .datatable-selector {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #dce1e7;
        }

        .datatable-pagination a {
            border-radius: 6px !important;
            margin: 0 2px;
            border: none !important;
            background: #f6f9ff !important;
            color: #4154f1 !important;
        }

        .datatable-pagination .active a {
            background: #4154f1 !important;
            color: #fff !important;
        }

        /* Dark Mode Variables */
        :root {
            --bg-color: #f0f2f5;
            --card-bg: #ffffff;
            --text-color: #444444;
            --heading-color: #012970;
            --border-color: rgba(0, 0, 0, 0.05);
            --header-bg: rgba(255, 255, 255, 0.8);
            --sidebar-bg: #ffffff;
        }

        [data-bs-theme="dark"] {
            --bg-color: #0b0f19;
            --card-bg: #151c2c;
            --text-color: #a9b1d1;
            --heading-color: #e0e6ed;
            --border-color: rgba(255, 255, 255, 0.08);
            --header-bg: rgba(21, 28, 44, 0.85);
            --sidebar-bg: #151c2c;
        }

        body {
            font-family: 'Inter', "Open Sans", sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: all 0.3s ease;
        }

        .card {
            background-color: var(--card-bg);
            border-color: var(--border-color);
            color: var(--text-color);
        }

        .card-title { color: var(--heading-color); }

        .header {
            background: var(--header-bg) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar {
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
        }

        .pagetitle h1 { color: var(--heading-color); }
        .logo span { color: var(--heading-color); }
        .breadcrumb-item.active { color: var(--text-color); opacity: 0.8; }
        .breadcrumb-item + .breadcrumb-item::before { color: var(--text-color); opacity: 0.5; }

        .table {
            color: var(--text-color);
            border-color: var(--border-color);
        }

        .bg-light {
            background-color: var(--bg-color) !important;
            color: var(--heading-color);
        }

        .theme-toggle-btn {
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-color);
        }

        .theme-toggle-btn:hover {
            background: rgba(65, 84, 241, 0.1);
            color: #4154f1;
        }

    </style>

</head>

<body>

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="d-flex align-items-center justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                <div class="logo-icon me-2">
                    <i class="bi bi-wallet2 text-primary fs-3"></i>
                </div>
                <span class="d-none d-lg-block">PayRoll <span class="text-primary">Pro</span></span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div>

        <div class="search-bar">
            <form class="search-form d-flex align-items-center" method="POST" action="#">
                <input type="text" name="query" placeholder="Search employees, records..." title="Enter search keyword">
                <button type="submit" title="Search"><i class="bi bi-search"></i></button>
            </form>
        </div><!-- End Search Bar -->

        <div class="ms-3">
            <button id="theme-toggle" class="theme-toggle-btn shadow-sm" title="Toggle Dark/Light Mode">
                <i class="bi bi-moon-stars"></i>
            </button>
        </div>

        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">
                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="d-none d-md-block dropdown-toggle ps-2">@Context.Session.GetString("EmployeeName")</span>
                    </a><!-- End Profile Iamge Icon -->

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@Context.Session.GetString("EmployeeName")</h6>
                            <span>@Context.Session.GetString("UserRole")</span>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="#">
                                <i class="bi bi-person"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out</span>
                            </a>
                        </li>

                    </ul><!-- End Profile Dropdown Items -->
                </li><!-- End Profile Nav -->
            </ul>
        </nav>
    </header>

    <aside id="sidebar" class="sidebar shadow-sm">
        <ul class="sidebar-nav" id="sidebar-nav">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            @if (Context.Session.GetString("UserRole") == "Admin")
            {
                <li class="nav-heading">Management</li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Employees" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Manage Employees</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Departments" asp-action="Index">
                        <i class="bi bi-building"></i>
                        <span>Manage Departments</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Designations" asp-action="Index">
                        <i class="bi bi-person-badge"></i>
                        <span>Manage Designation</span>
                    </a>
                </li>

                <li class="nav-heading">Finance</li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="BankDetails" asp-action="Index">
                        <i class="bi bi-credit-card-2-front"></i>
                        <span>Bank Details</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Payslips" asp-action="Index">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        <span>Generate Payslips</span>
                    </a>
                </li>
            }
            else
            {
                <li class="nav-heading">Employee Portal</li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="MyPayslips">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>My Payslips</span>
                    </a>
                </li>
            }

            <li class="nav-heading">Account</li>

            <li class="nav-item">
                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span>Sign Out</span>
                </a>
            </li>
        </ul>
    </aside>


    <main id="main" class="main">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </main>

    <footer id="footer" class="footer">
        <div class="copyright">
            &copy; Copyright <strong><span>PayRoll</span></strong>. All Rights Reserved @DateTime.Now.Year
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/template/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/template/vendor/chart.js/chart.umd.js"></script>
    <script src="~/template/vendor/echarts/echarts.min.js"></script>
    <script src="~/template/vendor/quill/quill.js"></script>
    <script src="~/template/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/template/vendor/tinymce/tinymce.min.js"></script>
    <script src="~/template/vendor/php-email-form/validate.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/template/js/main.js"></script>
    <script>


        // Theme Toggle Logic
        const themeToggle = document.getElementById('theme-toggle');
        const body = document.documentElement;
        const themeIcon = themeToggle.querySelector('i');

        const updateThemeIcon = (isDark) => {
            themeIcon.className = isDark ? 'bi bi-sun' : 'bi bi-moon-stars';
        };

        // Check for saved theme
        const savedTheme = localStorage.getItem('theme') || 'light';
        body.setAttribute('data-bs-theme', savedTheme);
        updateThemeIcon(savedTheme === 'dark');

        themeToggle.addEventListener('click', () => {
            const isDark = body.getAttribute('data-bs-theme') === 'dark';
            const newTheme = isDark ? 'light' : 'dark';
            
            body.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcon(!isDark);
        });

        // Global Search Functionality
        document.addEventListener("DOMContentLoaded", () => {
            const headerSearchForm = document.querySelector('.search-form');
            if (headerSearchForm) {
                const searchInput = headerSearchForm.querySelector('input[name="query"]');
                
                headerSearchForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const query = searchInput.value;
                    
                    if (window.allDataTables && window.allDataTables.length > 0) {
                        window.allDataTables.forEach(dt => dt.search(query));
                    }
                });

                // Real-time search
                searchInput.addEventListener('input', (e) => {
                    const query = e.target.value;
                    if (window.allDataTables && window.allDataTables.length > 0) {
                        window.allDataTables.forEach(dt => dt.search(query));
                    }
                });
            }
        });

        // Active navigation highlighting
        const currentUrl = window.location.pathname;
        const navLinks = document.querySelectorAll('#sidebar-nav .nav-link');

        navLinks.forEach(link => {
            const linkPath = new URL(link.href).pathname;
            if (linkPath === currentUrl || currentUrl.startsWith(linkPath + "/")) {
                link.classList.remove('collapsed');
            }
        });

        // Global Delete Confirmation
        function confirmDelete(url) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4154f1',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>

</body>

</html>